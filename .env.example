# ================================================================
# Drosophila Meyve Sineği Simülasyonu - Ortam Değişkenleri (.env)
# ================================================================
# Bu dosyayı ".env" olarak kopyalayıp kendi sunucu ayarlarınızı yazabilirsiniz:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
#
# Boş bırakıldığında simülasyon varsayılan olarak yerel sunucuya (ws://localhost:8765) bağlanır.

# Hedef Minecraft sunucusunun IP veya Domain adresi (Varsayılan: localhost)
MINECRAFT_HOST=localhost

# Hedef WebSocket portu (Varsayılan: 8765)
MINECRAFT_PORT=8765
