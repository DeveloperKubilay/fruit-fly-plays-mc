# ================================================================
# Drosophila Meyve Sineği Simülasyonu - Ortam Değişkenleri (.env)
# ================================================================
# Bu dosyayı ".env" olarak kopyalayıp kendi sunucu ayarlarınızı yazabilirsiniz:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
#
# Boş bırakıldığında simülasyon varsayılan olarak yerel sunucuya (ws://localhost:8765) bağlanır.

# Hedef Minecraft sunucusunun IP veya Domain adresi (Varsayılan: localhost)
# Doğrudan IP:Port olarak da yazabilirsiniz (Örn: 1.2.3.4:8765)
MINECRAFT_HOST=localhost

# Hedef WebSocket portu (Varsayılan: 8765, MINECRAFT_HOST içinde port belirtilmediyse kullanılır)
MINECRAFT_PORT=8765

# Güvenlik Şifresi / Token (Minecraft config.yml'deki brain.auth-token ile eşleşmelidir)
# MINECRAFT_PASSWORD veya FLY_AUTH_TOKEN olarak tanımlayabilirsiniz:
MINECRAFT_PASSWORD=drosophila_secret_token_123
FLY_AUTH_TOKEN=drosophila_secret_token_123
