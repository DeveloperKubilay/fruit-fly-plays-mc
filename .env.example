# ================================================================
# Drosophila Simulation - Environment Variables / Ortam Değişkenleri (.env)
# ================================================================
# Copy this file to ".env" and set your custom values:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
#
# If left empty or unset, defaults to local server (ws://localhost:8765).

# Target Minecraft server address (default: localhost)
# You can also provide IP:Port directly (e.g. 1.2.3.4:8765)
MINECRAFT_HOST=localhost

# Target WebSocket port (default: 8765, used if port not specified in MINECRAFT_HOST)
MINECRAFT_PORT=8765

# Security Password / Auth Token (Must match brain.auth-token in plugins/FruitFly/config.yml)
MINECRAFT_PASSWORD=drosophila_secret_token_123
FLY_AUTH_TOKEN=drosophila_secret_token_123
